{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-assessment-ai.local/schemas/taxonomy-release-manifest-1.0.json",
  "title": "Taxonomy Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_id",
    "taxonomy_version",
    "release_id",
    "parent_release_id",
    "status",
    "snapshot_file",
    "snapshot_sha256",
    "source_artifact_hashes",
    "counts",
    "approval_decision_refs",
    "approved_by",
    "created_at",
    "published_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "taxonomy_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "parent_release_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "status": {
      "enum": ["draft", "in_review", "release_candidate", "published", "retired"]
    },
    "snapshot_file": {
      "const": "snapshot.json"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_artifact_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exams", "sections", "competencies", "domains", "topics", "skills"],
      "properties": {
        "exams": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 },
        "competencies": { "type": "integer", "minimum": 0 },
        "domains": { "type": "integer", "minimum": 0 },
        "topics": { "type": "integer", "minimum": 0 },
        "skills": { "type": "integer", "minimum": 0 }
      }
    },
    "approval_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9._-]*$"
      }
    },
    "approved_by": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "reviewer", "reviewed_at"],
        "properties": {
          "decision_id": {
            "type": "string",
            "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "published" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "approval_decision_refs": { "minItems": 1 },
          "approved_by": { "minItems": 1 },
          "published_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  ]
}
